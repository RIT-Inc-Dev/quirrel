{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**",
      "development-ui/src/**",
      "development-ui/test/**",
      "test/**",
      "!test/fixtures"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "type"
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["development-ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "warn",
            "useButtonType": "warn"
          },
          "correctness": {
            "useExhaustiveDependencies": "warn",
            "useHookAtTopLevel": "warn"
          },
          "suspicious": {
            "noUnknownAtRules": {
              "level": "error",
              "options": {
                "ignore": ["tailwind"]
              }
            }
          }
        }
      }
    }
  ]
}
